APP_ENV=test
ALLOW_REAL_API=false

GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
SERPAPI_KEY=
GOOGLE_MAPS_KEY=

GEMINI_MODEL=gemini-2.0-flash
MAX_CONCURRENT_VIDEOS=1
DRAFT_TOOL_MAX_RETRY=3
MAX_REVISION_ROUNDS=2
ANSWER_LEAK_CHECK_ENABLED=true
DISTANCE_ERROR_THRESHOLD_KM=25

TOOL_REGISTRY_PATH=tool_registry.json
INTERMEDIATE_DIR=data/intermediate
OUTPUT_DIR=data/output
CACHE_DIR=.cache
