APP_ENV=test
ALLOW_REAL_API=false

# LLM：默认通义千问（DashScope OpenAI 兼容）
LLM_PROVIDER=qwen
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus
DASHSCOPE_API_KEY=

# 可选：切回 Gemini 时设 LLM_PROVIDER=gemini 并填写下方
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
SERPAPI_KEY=
GOOGLE_MAPS_KEY=

# 地图：amap（高德 Web 服务，国内推荐）| nominatim（OSM）
MAP_PROVIDER=amap
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com
AMAP_TIMEOUT_SEC=10
# MAP_PROVIDER=nominatim 时使用
NOMINATIM_USER_AGENT=geoagent-dataset/1.0 (local; contact via project repo)
NOMINATIM_TIMEOUT_SEC=10

MAX_CONCURRENT_VIDEOS=1
DRAFT_TOOL_MAX_RETRY=3
MAX_REVISION_ROUNDS=2
ANSWER_LEAK_CHECK_ENABLED=true
DISTANCE_ERROR_THRESHOLD_KM=25

TOOL_REGISTRY_PATH=tool_registry.json
INTERMEDIATE_DIR=data/intermediate
OUTPUT_DIR=data/output
CACHE_DIR=.cache
