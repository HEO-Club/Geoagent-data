APP_ENV=test
# 默认关闭真实外网。正式跑或 MCP 宿主设 true；pytest 会强制 false 并拦截未 mock 的 HTTP。
ALLOW_REAL_API=false
# 真实 Tool API 独立闸门，避免启用 Stage 2 LLM 时意外上传图片。
ALLOW_REAL_TOOL_API=false
# 自定义 Tool 端点必须是 HTTPS；仅在明确审查过目标主机后开启。
ALLOW_CUSTOM_TOOL_ENDPOINTS=false
# 公共 Nominatim/Overpass 要求能识别调用方；不要使用 requests/python 默认 UA。
# GEOAGENT_USER_AGENT=Geoagent-data/0.1 (contact: your-email@example.com)
# NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org
# OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
# OVERPASS_TIMEOUT_SEC=45

# Stage 1 主路径：分窗音频 → 真实 ASR
ASR_PROVIDER=qwen
ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ASR_MODEL=qwen3-asr-flash
ASR_LANGUAGE=zh
# 仅在明确允许发送视频帧时开启；纯 ASR 批处理可设为 false。
STAGE1_ALLOW_VLM_FALLBACK=true

# Stage 1 退路：ASR 无文本时只读取关键帧中实际可见的字幕
VLM_PROVIDER=qwen
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen3.8-flash
DASHSCOPE_API_KEY=

# --- LLM 主通道（stage2/3；百炼 Qwen 多模态）---
LLM_PROVIDER=qwen
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
# 可选：切回 Kimi 时改 PROVIDER/BASE_URL/MODEL 并填写下方
MOONSHOT_API_KEY=
KIMI_REASONING_EFFORT=low
LLM_TIMEOUT_SEC=300

# 可选：切回 Gemini 时设对应 PROVIDER=gemini 并填写下方
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# reverse_image_search：默认 SerpAPI Google Lens；可选 Google Cloud Vision
# 本地 .env 也可使用别名 SERPAPI_KEY
SERPAPI_API_KEY=
# SERPAPI_ENDPOINT=https://serpapi.com/search.json
# SERPAPI_IMAGE_ENDPOINT=https://serpapi.com/image
# SERPAPI_TIMEOUT_SEC=30
GOOGLE_VISION_API_KEY=
# GOOGLE_VISION_ENDPOINT=https://vision.googleapis.com/v1/images:annotate
# GOOGLE_VISION_TIMEOUT_SEC=30

# web_search：Brave Search Web API（只返回标题/链接/摘要；正文用 web_page_read）
# 本地 .env 也可使用别名 BRAVE_API_KEY
BRAVE_SEARCH_API_KEY=
# BRAVE_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search
# BRAVE_SEARCH_TIMEOUT_SEC=30

# web_page_read：HTTP 直读正文；动态页可选 Playwright（不接 Firecrawl/MCP）
# WEB_PAGE_READ_TIMEOUT_SEC=30
# WEB_PAGE_READ_MAX_BYTES=2097152
# WEB_PAGE_READ_USER_AGENT=geoagent-dataset/1.0 (web_page_read; local)
# WEB_PAGE_READ_JS_ENGINE=playwright

# media_search：Wikimedia Commons（免 API Key；只返回元数据与链接，不下载）
# MEDIA_SEARCH_COMMONS_ENDPOINT=https://commons.wikimedia.org/w/api.php
# MEDIA_SEARCH_TIMEOUT_SEC=30
# MEDIA_SEARCH_USER_AGENT=geoagent-dataset/1.0 (media_search; local)

# poi_search / geocode / route_query：高德 Web 服务（Web 服务 Key；接口坐标为 GCJ-02，执行器进出转为 WGS-84；结果不授予再分发/训练使用权）
# 本地 .env 也可使用别名 AMAP_API_KEY
AMAP_WEB_KEY=
# AMAP_POI_ENDPOINT=https://restapi.amap.com/v3/place
# AMAP_GEOCODE_ENDPOINT=https://restapi.amap.com/v3/geocode
# AMAP_DIRECTION_ENDPOINT=https://restapi.amap.com/v3/direction
# AMAP_BICYCLING_ENDPOINT=https://restapi.amap.com/v4/direction/bicycling
# AMAP_TIMEOUT_SEC=30
# geocode 默认 GEOCODE_PROVIDER=amap；可选 nominatim（必须自建端点，默认拒绝公共 OSM 实例）
# GEOCODE_PROVIDER=amap
# GEOCODE_NOMINATIM_ENDPOINT=
# GEOCODE_NOMINATIM_USER_AGENT=geoagent-dataset/1.0 (geocode; local)
# GEOCODE_NOMINATIM_TIMEOUT_SEC=10
# GEOCODE_ALLOW_PUBLIC_NOMINATIM=false
# route_query 默认 ROUTE_QUERY_PROVIDER=amap；可选 osrm（必须自建端点，默认拒绝公共 OSRM 实例）
# ROUTE_QUERY_PROVIDER=amap
# ROUTE_OSRM_ENDPOINT=
# ROUTE_OSRM_USER_AGENT=geoagent-dataset/1.0 (route_query; local)
# ROUTE_OSRM_TIMEOUT_SEC=30
# ROUTE_ALLOW_PUBLIC_OSRM=false
# map_layer_query：OGC WMS GetMap（可选同一 GeoServer 的 WFS）；端点与图层映射只读环境变量
# MAP_LAYER_PROVIDER=wms
# MAP_LAYER_WMS_ENDPOINT=
# MAP_LAYER_WFS_ENDPOINT=
# MAP_LAYER_WMS_VERSION=1.3.0
# MAP_LAYER_WFS_VERSION=2.0.0
# MAP_LAYER_WMS_CRS=EPSG:4326
# MAP_LAYER_WMS_LAYERS={"hydrology":"workspace:rivers"}
# MAP_LAYER_WFS_LAYERS=
# MAP_LAYER_WMS_USER=
# MAP_LAYER_WMS_PASSWORD=
# MAP_LAYER_WMS_USER_AGENT=geoagent-dataset/1.0 (map_layer_query; local)
# MAP_LAYER_TIMEOUT_SEC=30
# MAP_LAYER_MAX_FEATURES=200

# osm_query：Overpass interpreter（免 API Key；坐标为 WGS84）
# 大数据量可将端点改到灌入 Geofabrik 中国提取的自建 Overpass：
# https://download.geofabrik.de/asia/china.html
# OSM_QUERY_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
# OSM_QUERY_OVERPASS_USER_AGENT=geoagent-dataset/1.0 (osm_query; local)
# OSM_QUERY_TIMEOUT_SEC=25
# OSM_QUERY_MAX_LIMIT=200

# streetview_query：默认 Mapillary Graph API（本阶段不接 Google Street View）
# 本地 .env 也可使用别名 MAPILLARY_TOKEN
MAPILLARY_ACCESS_TOKEN=
# STREETVIEW_PROVIDER=mapillary
# MAPILLARY_ENDPOINT=https://graph.mapillary.com
# MAPILLARY_TIMEOUT_SEC=30
# MAPILLARY_USER_AGENT=geoagent-dataset/1.0 (streetview_query; local)
# MAPILLARY_SEARCH_RADIUS_M=50
# MAPILLARY_IMAGE_LIMIT=50

# satellite_imagery_query：默认 Copernicus Data Space Catalog + Process API（本阶段不接 Planet / Cesium）
# 在 CDSE 控制台创建免费 OAuth 客户端；测试保持 ALLOW_REAL_API=false
# SATELLITE_PROVIDER=copernicus
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# COPERNICUS_CATALOG_ENDPOINT=https://sh.dataspace.copernicus.eu/api/v1/catalog/1.0.0/search
# COPERNICUS_PROCESS_ENDPOINT=https://sh.dataspace.copernicus.eu/api/v1/process
# COPERNICUS_TOKEN_ENDPOINT=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
# COPERNICUS_TIMEOUT_SEC=30
# COPERNICUS_USER_AGENT=geoagent-dataset/1.0 (satellite_imagery_query; local)
# SATELLITE_SEARCH_RADIUS_M=2000
# SATELLITE_PREVIEW_WIDTH=512
# SATELLITE_PREVIEW_HEIGHT=512
# SATELLITE_SCENE_LIMIT=50

# weather_archive_query：Open-Meteo Archive 时序 + NASA GIBS WMS 图层（均免 API Key）
# 测试保持 ALLOW_REAL_API=false
# WEATHER_ARCHIVE_OPENMETEO_ENDPOINT=https://archive-api.open-meteo.com/v1/archive
# WEATHER_ARCHIVE_GIBS_ENDPOINT=https://gibs.earthdata.nasa.gov/wms/epsg4326/best/wms.cgi
# WEATHER_ARCHIVE_TIMEOUT_SEC=30
# WEATHER_ARCHIVE_USER_AGENT=geoagent-dataset/1.0 (weather_archive_query; local)
# WEATHER_ARCHIVE_PREVIEW_WIDTH=512
# WEATHER_ARCHIVE_PREVIEW_HEIGHT=512

# visibility_analysis：点到点 DEM 视线；不下载地形，不跑 viewshed
# VISIBILITY_CURVATURE=true
# VISIBILITY_CURVATURE_K=1.33

# terrain_analysis：本地 Horn DEM 分析；无本地栅格时经闸门调用 OpenTopography
# 测试保持 ALLOW_REAL_API=false
OPENTOPOGRAPHY_API_KEY=
# TERRAIN_DEM_TYPE=COP30
# TERRAIN_OT_ENDPOINT=https://portal.opentopography.org/API/globaldem
# TERRAIN_OT_TIMEOUT_SEC=30
# TERRAIN_OT_USER_AGENT=geoagent-dataset/1.0 (terrain_analysis; local)
# TERRAIN_MAX_BBOX_DEG=2

# administrative_registry：GeoNames 通用地名库（需免费 username）；可选本地官方 dump
# 测试保持 ALLOW_REAL_API=false
GEONAMES_USERNAME=
# GEONAMES_ENDPOINT=https://secure.geonames.org
# GEONAMES_TIMEOUT_SEC=30
# GEONAMES_USER_AGENT=geoagent-dataset/1.0 (administrative_registry; local)
# ADMINISTRATIVE_REGISTRY_OFFICIAL_PATH=

# infrastructure_registry：地区建设/许可档案连接器（无全球统一接口）
# 测试保持 ALLOW_REAL_API=false
# 英格兰结构化源：Planning Data（免 API Key）；国内用授权 dump，不爬住建验证码站
# PLANNING_DATA_ENDPOINT=https://www.planning.data.gov.uk/entity.json
# PLANNING_DATA_TIMEOUT_SEC=30
# PLANNING_DATA_USER_AGENT=geoagent-dataset/1.0 (infrastructure_registry; local)
# INFRASTRUCTURE_REGISTRY_DUMP_PATH=

# flight_data_query：OpenSky REST（ADS-B 实际接收；可选 OAuth2）
# 测试保持 ALLOW_REAL_API=false；无 client 时只能查当前状态向量
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
# OPENSKY_ENDPOINT=https://opensky-network.org/api
# OPENSKY_TOKEN_ENDPOINT=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token
# OPENSKY_TIMEOUT_SEC=30
# OPENSKY_USER_AGENT=geoagent-dataset/1.0 (flight_data_query; local)

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# llm_query：复用上方 LLM_*（Anthropic Messages 或 OpenAI 兼容中转）；测试保持 ALLOW_REAL_API=false
# LLM_QUERY_PROVIDER=
# LLM_QUERY_TIMEOUT_SEC=60

# Stage 2 使用 Anthropic Messages 协议时：
# LLM_PROVIDER=anthropic
# 仅配置 HTTPS；可按顺序填写多个中转端点，逗号分隔。
LLM_ANTHROPIC_BASE_URLS=https://api.anthropic.com
LLM_ANTHROPIC_MODEL=claude-sonnet-5
LLM_ANTHROPIC_API_KEY=
# 长响应经过 Cloudflare 中转时可开启 SSE，避免非流式请求触发 524。
LLM_ANTHROPIC_STREAM=true
LLM_MAX_OUTPUT_TOKENS=8192
ALLOW_INSECURE_LLM_ENDPOINTS=false

MAX_CONCURRENT_VIDEOS=1
# Stage 2：明确虚假 Observation 或高置信漏动作带警示重生成；含首次最多三次，达到上限继续下游。
STAGE2_OBSERVATION_REVIEW=true
STAGE2_ACTION_COVERAGE_REVIEW=true
STAGE2_MAX_GENERATIONS=3
# 阶段1.5：稀疏审核、出示窗密采样与候选帧质量门禁
AUDIT_SPARSE_FRAME_COUNT=8
AUDIT_MAX_KEYFRAMES_PER_TASK=8
AUDIT_DISPLAY_SAMPLE_INTERVAL_SEC=1.0
AUDIT_DISPLAY_WINDOW_MAX_SEC=90
AUDIT_MAX_SAMPLED_FRAMES=120
AUDIT_MAX_VLM_FRAME_VERIFIES=24
AUDIT_TASK_BOUNDARY_TOLERANCE_SEC=20
AUDIT_MIN_FRAME_QUALITY=0.65
AUDIT_MIN_CHAIN_SUPPORT=0.5
AUDIT_VISUAL_HASH_DISTANCE=6
OBS_SYNTH_MAX_RETRY=3
MAX_REVISION_ROUNDS=2
ANSWER_LEAK_CHECK_ENABLED=true
DISTANCE_ERROR_THRESHOLD_KM=25

# stage6 逆地理（Nominatim）
NOMINATIM_USER_AGENT=geoagent-dataset/1.0 (stage6; local)
NOMINATIM_TIMEOUT_SEC=10

# 阶段3：每个 tool_call 用 LLM 对照 schema 从 Thought 编译 params（失败开放）
STAGE3_COMPILE_PARAMS=true

TOOL_CATALOG_PATH=canonical_tool_catalog_v2.json
# 已废弃：流水线不再读写跨视频 runtime dump；保留配置键以免破坏旧 .env
TOOL_TREES_PATH=tool_trees.json
INTERMEDIATE_DIR=data/intermediate
SELECTED_DIR=data/selected
RUNS_DIR=data/runs
OUTPUT_DIR=data/output
CACHE_DIR=.cache
