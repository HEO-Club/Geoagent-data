APP_ENV=test
ALLOW_REAL_API=false

# --- VLM 通道（stage3 之前：prep_transcript_vlm / stage1；多模态）---
VLM_PROVIDER=qwen
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen3.7-plus
DASHSCOPE_API_KEY=

# --- LLM 主通道（stage3+：normalize / Obs / stage5–6；多模态，含图片）---
LLM_PROVIDER=kimi
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=kimi-k3
MOONSHOT_API_KEY=
# 国际站可改为 https://api.moonshot.ai/v1
# kimi-k3：low|high|max（流水线建议 low 控延迟）
KIMI_REASONING_EFFORT=low
LLM_TIMEOUT_SEC=300

# 可选：切回 Gemini 时设对应 PROVIDER=gemini 并填写下方
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

MAX_CONCURRENT_VIDEOS=1
OBS_SYNTH_MAX_RETRY=3
MAX_REVISION_ROUNDS=2
ANSWER_LEAK_CHECK_ENABLED=true
DISTANCE_ERROR_THRESHOLD_KM=25

# stage6 逆地理（Nominatim）
NOMINATIM_USER_AGENT=geoagent-dataset/1.0 (stage6; local)
NOMINATIM_TIMEOUT_SEC=10

TOOL_REGISTRY_PATH=tool_registry.json
INTERMEDIATE_DIR=data/intermediate
OUTPUT_DIR=data/output
CACHE_DIR=.cache
