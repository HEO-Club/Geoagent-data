  "implementation_research": {
    "architecture": "gazetteer_plus_official_regional_sources",
    "backends": [
      {
        "name": "GeoNames",
        "kind": "external_api_or_offline_dump",
        "role": "全球地名、别名和行政层级",
        "official_url": "https://www.geonames.org/export/ws-overview.html",
        "authentication": "GeoNames username",
        "license_note": "使用前核对软件与数据许可。"
      },
      {
        "name": "国家地名信息库/地方民政资料",
        "kind": "official_web_or_import",
        "role": "中国标准地名与行政资料",
        "official_url": "https://app.www.gov.cn/govdata/gov/202212/25/495555/article.html",
        "authentication": "按具体来源",
        "license_note": "很多来源没有统一公开 API，需要人工导入与逐来源许可。"
      }
    ],
    "execution_flow": [
      "按 registry 和 area 选数据源",
      "查询标准名、别名和层级",
      "保留有效时间与官方出处"
    ],
    "limitations": [
      "当前行政归属不能自动外推到历史年份",
      "地名库质量与覆盖不同",
      "未查到不能证明名称不存在"
    ],
    "mcp_strategy": "按国家/地区做 connector，统一输出 provenance 和 validity interval。"
  },
  "recommended_executor_contract": {
    "required_result_fields": [
      "status",
      "provider_or_algorithm",
      "request_parameters_used",
      "retrieved_at",
      "source_result_id_or_raw_ref",
      "provenance",
      "warnings"
    ],
    "status_values": [
      "success",
      "no_result",
      "no_coverage",
      "parameter_missing",
      "unsupported",
      "permission_denied",
      "provider_error"
    ],
    "rules": [
      "no_result 与 no_coverage、provider_error 必须分开",
      "任何精确数值必须带单位、方法和源数据",
      "调用失败不得生成看似成功的 Observation",
      "密钥、令牌和内部文件系统路径不得进入训练样本"
    ]
  },
