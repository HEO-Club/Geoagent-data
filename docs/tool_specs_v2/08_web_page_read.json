  "implementation_research": {
    "architecture": "http_reader_with_browser_fallback",
    "backends": [
      {
        "name": "Firecrawl",
        "kind": "external_api_or_mcp",
        "role": "网页正文提取与抓取",
        "official_url": "https://docs.firecrawl.dev/mcp-server",
        "authentication": "Firecrawl API Key",
        "license_note": "使用前核对软件与数据许可。"
      },
