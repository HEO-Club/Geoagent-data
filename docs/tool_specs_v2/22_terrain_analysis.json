        "license_note": "数据集、配额和商业使用条件按账户核对。"
      }
    ],
    "execution_flow": [
      "获取/解析真实 DEM",
      "统一垂直/水平单位和 CRS",
      "计算 metrics 或 path 剖面并返回数据版本"
    ],
    "limitations": [
      "低分辨率 DEM 不支持精细局部结论",
      "高程基准与单位差异需校正",
      "地形分析不能自动包含城市障碍物"
    ],
    "mcp_strategy": "本地 GDAL worker；数据下载由独立受控 provider 完成。"
