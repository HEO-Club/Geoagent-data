  "implementation_research": {
    "architecture": "local_dem_viewshed",
    "backends": [
      {
        "name": "GDAL viewshed",
        "kind": "local_cli_or_library",
        "role": "DEM 可视域与最小可见高度",
        "official_url": "https://gdal.org/en/stable/programs/gdal_raster_viewshed.html",
        "authentication": "无",
        "license_note": "使用前核对软件与数据许可。"
      }
    ],
    "execution_flow": [
      "解析 observer/target 和高度",
      "选择覆盖区域且投影正确的 DEM/DSM",
      "输出视线剖面、遮挡位置或 viewshed raster"
    ],
    "limitations": [
      "裸地 DEM 不包含建筑树木",
      "投影与高度基准必须明确",
      "数据分辨率决定可验证尺度"
    ],
    "mcp_strategy": "本地 GIS worker；限制最大范围和计算资源。"
  },
