      }
    ],
    "execution_flow": [
      "解析视频 ID 与目标时间戳",
      "按 PTS 解码而非固定帧率乘法",
      "返回实际帧时间、图片 ID 和源视频"
    ],
    "limitations": [
      "关键帧 seek 后需解码到目标时刻",
      "可变帧率必须记录实际 PTS",
      "提取成功不代表该帧是正确题图"
    ],
    "mcp_strategy": "本地 executor；批量时间戳应一次打开视频复用解码器。"
  },
