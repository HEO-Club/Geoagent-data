    "execution_flow": [
      "解析真实 image 引用与 ROI",
      "执行确定性变换并保存新 image_id",
      "返回源图、参数、尺寸和处理日志"
    ],
    "limitations": [
      "放大不能恢复原图不存在的细节",
      "生成式修复不得作为证据增强",
      "所有变换必须可复现且保留源图"
    ],
    "mcp_strategy": "优先本地 Python executor；需要跨 Agent 使用时再用 MCP Python SDK 包装。"
  },
  "recommended_executor_contract": {
