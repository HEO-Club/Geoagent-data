[
  {
    "name": "web_search",
    "description": "按用途检索网页，用于地理线索的广泛发现、精确查找或验证。",
    "tier": "production",
    "params": [
      {
        "name": "query",
        "type": "string",
        "required": true,
        "description": "检索查询语句，如[red brick church spire Europe]",
        "example": "red brick church spire Europe",
        "default": null,
        "enum_values": null
      },
      {
        "name": "top_k",
        "type": "int",
        "required": false,
        "description": "返回结果条数上限，如[3]",
        "example": 3,
        "default": 3,
        "enum_values": null
      },
      {
        "name": "purpose",
        "type": "string",
        "required": true,
        "description": "检索用途约束，如[broad_discovery]",
        "example": "broad_discovery",
        "default": null,
        "enum_values": [
          "broad_discovery",
          "precise_lookup",
          "verification"
        ]
