        "type": "result_list",
        "nullable": true,
        "description": "检索命中列表；empty/error 时可为 null",
        "item_fields": [
          {
            "name": "title",
            "type": "string",
            "nullable": false,
            "description": "结果标题文本，如[Example Page Title]",
            "item_fields": null
          },
          {
            "name": "snippet",
            "type": "string",
            "nullable": false,
            "description": "结果摘要片段，如[short page summary]",
            "item_fields": null
          },
          {
            "name": "url",
            "type": "string",
            "nullable": false,
            "description": "结果链接地址，如[https://example.com]",
            "item_fields": null
          }
        ]
